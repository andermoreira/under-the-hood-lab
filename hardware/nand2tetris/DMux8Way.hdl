// One input, eight mutually exclusive outputs.
CHIP DMux8Way {
 IN in, sel[3];
 OUT a, b, c, d, e, f, g, h;
 PARTS:
 Not(in=sel[0], out=n0);
 Not(in=sel[1], out=n1);
 Not(in=sel[2], out=n2);
 And(a=in, b=n2, out=lo);
 And(a=in, b=sel[2], out=hi);
 DMux4Way(in=lo, sel=sel[0..1], a=a, b=b, c=c, d=d);
 DMux4Way(in=hi, sel=sel[0..1], a=e, b=f, c=g, d=h);
}
